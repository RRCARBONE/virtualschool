# ---------------------------------------------------------------------------
# Supabase (banco de dados + autenticação)
# ---------------------------------------------------------------------------
# Sem essas duas variáveis, a plataforma roda em "modo demonstração": o
# catálogo (áreas, profissões, cursos) vem de src/lib/data, o progresso do
# aluno fica salvo no localStorage do navegador, e login/cadastro simulam a
# sessão sem persistência real. Preencha para conectar dados reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# IA (professores virtuais, chat e recomendação de profissões)
# ---------------------------------------------------------------------------
# Usada exclusivamente no servidor (src/lib/ai/client.ts e as rotas em
# src/app/api/ai/*) — nunca é enviada ao navegador. Sem ela, o chat e o
# questionário "Descobrir profissão" caem em respostas locais de demonstração.
ANTHROPIC_API_KEY=
# Opcional — modelo padrão: claude-sonnet-5
ANTHROPIC_MODEL=
